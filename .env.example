# Local development only. Copy to .env and replace values there; never commit .env.
NODE_ENV=development

# Hosted sync service
GOSU_SYNC_API_HOST=127.0.0.1
GOSU_SYNC_API_PORT=4000
GOSU_WEB_PORT=3000
GOSU_ALLOWED_ORIGINS=http://127.0.0.1:3000
GOSU_AUTH_MODE=development
GOSU_OIDC_ISSUER=https://auth.example.invalid
GOSU_OIDC_AUDIENCE=gosu-sync

# Docker Compose development services
GOSU_POSTGRES_DB=gosu
GOSU_POSTGRES_USER=gosu
GOSU_POSTGRES_PASSWORD=local-development-only
GOSU_POSTGRES_PORT=5432
GOSU_REDIS_PORT=6379
DATABASE_URL=postgresql://gosu:local-development-only@127.0.0.1:5432/gosu
GOSU_PERSISTENCE=memory
GOSU_POSTGRES_POOL_SIZE=10
GOSU_POSTGRES_SSL=disable
REDIS_URL=redis://127.0.0.1:6379

# OAuth placeholders. Use provider-issued values only in your ignored .env file.
GOSU_GOOGLE_CLIENT_ID=replace-with-local-google-client-id
GOSU_GOOGLE_CLIENT_SECRET=replace-with-local-google-client-secret
GOSU_APPLE_CLIENT_ID=replace-with-local-apple-client-id
GOSU_APPLE_TEAM_ID=replace-with-local-apple-team-id
GOSU_APPLE_KEY_ID=replace-with-local-apple-key-id
GOSU_APPLE_PRIVATE_KEY_PATH=/absolute/path/outside/repository/to/apple-private-key.p8

# Public callback base used by local OAuth flows.
GOSU_PUBLIC_BASE_URL=http://127.0.0.1:4000

# GitHub App placeholders. Keep private keys outside this repository.
GOSU_GITHUB_APP_ID=replace-with-local-github-app-id
GOSU_GITHUB_CLIENT_ID=replace-with-local-github-client-id
GOSU_GITHUB_CLIENT_SECRET=replace-with-local-github-client-secret
GOSU_GITHUB_PRIVATE_KEY_PATH=/absolute/path/outside/repository/to/github-app-private-key.pem
GOSU_GITHUB_WEBHOOK_SECRET=replace-with-random-local-webhook-secret

# Reserved runner mTLS paths for the enrollment adapter (not loaded by the
# current skeleton); values are paths, never certificate contents.
GOSU_RUNNER_CA_PATH=/absolute/path/outside/repository/to/runner-ca.pem
GOSU_RUNNER_CERT_PATH=/absolute/path/outside/repository/to/runner-cert.pem
GOSU_RUNNER_KEY_PATH=/absolute/path/outside/repository/to/runner-key.pem

# Runner control is disabled while the URL is empty. For loopback development,
# set a project and lab fixture explicitly; non-loopback operation requires WSS
# and the future mTLS enrollment path documented by the Runner.
GOSU_RUNNER_ID=local-dev-runner
GOSU_RUNNER_CONTROL_WS_URL=
GOSU_RUNNER_PROJECT_ID=
GOSU_RUNNER_CONTROL_LAB_ID=
GOSU_RUNNER_EXECUTION_ENABLED=false

# GPU execution is disabled while both values remain empty/zero. Configure only
# concrete NVIDIA CDI selectors discovered on the runner host; never put SSH or
# cloud-provider credentials here.
GOSU_RUNNER_GPU_DEVICES=
GOSU_RUNNER_MAX_GPU_MEMORY_MIB=0
