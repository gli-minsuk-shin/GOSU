{
  "name": "@gosu/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "GOSU — Goal-Oriented Science, Unified",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gli-minsuk-shin/GOSU.git"
  },
  "bugs": {
    "url": "https://github.com/gli-minsuk-shin/GOSU/issues"
  },
  "homepage": "https://github.com/gli-minsuk-shin/GOSU#readme",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "app:dev": "exec node scripts/run-local.mjs",
    "app:doctor": "node scripts/doctor.mjs",
    "app:package": "pnpm check && pnpm --filter @gosu/desktop package:mac:dev",
    "app:package:release": "pnpm check && pnpm --filter @gosu/desktop package:mac:release",
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "contracts:check": "pnpm --filter @gosu/contracts generate:check",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts && turbo run lint",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
