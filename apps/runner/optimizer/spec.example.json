{
  "study_name": "demo-metric-optimization",
  "direction": "maximize",
  "seed": 7,
  "n_trials": 10,
  "trial_timeout_seconds": 300,
  "working_directory": ".",
  "search_space": {
    "learning_rate": {
      "type": "float",
      "low": 0.0001,
      "high": 0.1,
      "log": true
    },
    "batch_size": {
      "type": "categorical",
      "choices": [16, 32, 64]
    }
  },
  "objective": {
    "executable": "python3",
    "args": [
      "train.py",
      "--learning-rate",
      "{{learning_rate}}",
      "--batch-size",
      "{{batch_size}}",
      "--metric-output",
      "metrics/trial-{{trial_number}}.json"
    ],
    "metric_file": "metrics/trial-{{trial_number}}.json",
    "metric_key": "score"
  }
}
