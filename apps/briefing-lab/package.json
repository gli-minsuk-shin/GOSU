{
  "name": "@gosu/briefing-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gosu/briefing-core build && vite --host 127.0.0.1 --port 4318 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort",
    "build": "pnpm --filter @gosu/briefing-core build && vite build",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke:visual:mac": "pnpm build && pnpm --filter @gosu/desktop exec electron ../../apps/briefing-lab/tools/visual-smoke.cjs"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.0",
    "@gosu/briefing-core": "workspace:*",
    "@gosu/contracts": "workspace:*",
    "@gosu/integrations": "workspace:*",
    "@gosu/ui": "workspace:*",
    "@openai/codex": "0.149.0",
    "@xmldom/xmldom": "0.8.13",
    "katex": "0.16.47",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.3",
    "temporal-polyfill": "^1.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "react-test-renderer": "19.2.8",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
