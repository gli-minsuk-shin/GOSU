{
  "name": "@gosu/desktop",
  "version": "0.7.0",
  "private": true,
  "author": "GOSU contributors",
  "description": "Local-first macOS research workspace for GOSU",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node ../../scripts/verify-preload-bundle.mjs",
    "preview": "electron-vite preview",
    "package:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "smoke:local-db:mac": "electron-builder install-app-deps && electron-vite build --config test/electron/electron.vite.config.ts && electron out/local-database-smoke/main.cjs",
    "lint": "eslint src electron.vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gosu/contracts": "workspace:*",
    "@openai/codex": "0.146.0",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "science.gosu.desktop",
    "productName": "GOSU",
    "afterPack": "../../scripts/harden-mac-package.mjs",
    "asar": true,
    "asarUnpack": [
      "node_modules/@openai/codex/**",
      "node_modules/@openai/codex-*/**",
      "node_modules/better-sqlite3-multiple-ciphers/**"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "sign": false
    },
    "publish": null
  }
}
