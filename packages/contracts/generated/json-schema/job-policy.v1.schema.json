{
  "$id": "urn:gosu:contract:v1:JobPolicyV1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "policyVersion": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "policyHash": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]+$"
    },
    "allowedSigningKeyIds": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "allowedImageDigests": {
      "minItems": 1,
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "allowedNetworkHosts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 253 }
    },
    "allowedSecretRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "maxJobTimeoutSeconds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "policyVersion",
    "policyHash",
    "allowedSigningKeyIds",
    "allowedImageDigests",
    "allowedNetworkHosts",
    "allowedSecretRefs",
    "maxJobTimeoutSeconds"
  ],
  "additionalProperties": false
}
