{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env.example",
    "tsconfig.base.json",
    "apps/briefing-lab/src/paper-summary-contract.ts",
    "apps/briefing-lab/src/paper-summary-offer.tsx",
    "apps/briefing-lab/src/paper-summary-offer.css",
    "apps/briefing-lab/paper-summary-library.ts",
    "apps/briefing-lab/briefing-system-key.ts",
    "scripts/lab-bundles.mjs",
    "scripts/lab-bundles.d.mts"
  ],
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**", "release/**"]
    },
    "@gosu/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
